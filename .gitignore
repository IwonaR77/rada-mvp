# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase
supabase/.temp
supabase/.branches

# typescript
*.tsbuildinfo
next-env.d.ts

# whisper/: working files for the transcription pipeline, not part of the project
/whisper

# run1/, run2/: transcription output dumps, not part of the project
/run1
/run2

# summary/: manually generated session summaries, not part of the project
/summary

# radni/: versioned prompt + working notes for councilor session-activity
# synthesis (mirrors summary/), not part of the project
/radni

# prompt/: periodic snapshots of a full build-prompt for model comparison, not part of the project
/prompt

# protokoly/: locally-dropped session protokół PDFs (from BIP or FOI requests),
# fed to scripts/match-protokol-speakers.py -- source documents, not part of the project
/protokoly

# backups/: daily database dumps (scripts/backup-db.sh), never committed
/backups
/backup-db.log

# python
__pycache__/
*.pyc
