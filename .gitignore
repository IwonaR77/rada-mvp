# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase
supabase/.temp
supabase/.branches

# typescript
*.tsbuildinfo
next-env.d.ts

# whisper/: working files for the OLD whisperx transcription pipeline
# (secrets, SSH key, downloaded media, whisperx scripts, tokens.txt) — not
# part of the project, kept only as a manual fallback (see groq/ for the
# active pipeline, which has its own copy of tokens.txt).
/whisper

# groq/: active transcription pipeline (see .github/workflows/transcribe-groq.yml).
# Code and tokens.txt are tracked; the local API key, transient working
# files, and generated mp3 stats are not.
/groq/.env.groq
/groq/work
/groq/mp3-stats.json

# run1/, run2/: transcription output dumps, not part of the project
/run1
/run2

# summary/: manually generated session summaries, not part of the project
/summary

# prompt/: leftover reference screenshots (model-comparison), not part of the project.
# Its actual prompt files live in prompty-prywatne/ now — see below.
/prompt

# prompty-prywatne/: all private/draft prompts (radni, summary, dated build-prompt
# snapshots) live here now. Public, published prompts are the sibling folder
# prompty/, which IS tracked and read at runtime by the /prompt-* pages.
/prompty-prywatne

# protokoly/: locally-dropped session protokół PDFs (from BIP or FOI requests),
# fed to scripts/match-protokol-speakers.py -- source documents, not part of the project
/protokoly

# backups/: daily database dumps (scripts/backup-db.sh), never committed
/backups
/backup-db.log

# python
__pycache__/
*.pyc

# certs/: self-signed TLS cert+key for temporary HTTPS (no domain yet) —
# private key must never be committed, regenerate with scripts/gen-temp-ssl.sh
/certs

# notatki/: private working notes (handoff instructions, drafts, etc.), not part of the project
/notatki

# .remove_*: staged for deletion during folder cleanup — renamed here, not yet
# deleted, so they stay out of git while under review
.remove_*
